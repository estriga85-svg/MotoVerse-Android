rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Important: email ownership must be verified to receive admin access.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'estriga85@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.buyerUid == request.auth.uid
          || get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerUid == request.auth.uid
          || isAdmin()
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();

      match /favorites/{favoriteId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /alerts/{alertId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /garages/{userId} {
      allow read, create, update, delete: if isOwner(userId) || isAdmin();
    }

    match /listings/{listingId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if resource.data.status == 'approved'
        || (signedIn() && (
          resource.data.ownerUid == request.auth.uid || isAdmin()
        ));

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status
      );

      allow delete: if isAdmin() || (
        signedIn() && resource.data.ownerUid == request.auth.uid
      );
    }

    match /meetups/{meetupId} {
      allow read: if resource.data.status == 'active'
        || (signedIn() && (
          resource.data.organizerUid == request.auth.uid || isAdmin()
        ));

      allow create: if signedIn()
        && request.resource.data.organizerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.organizerVerified ==
          (request.auth.token.email_verified == true || isAdmin());

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.organizerUid == request.auth.uid
        && request.resource.data.organizerUid == resource.data.organizerUid
        && request.resource.data.organizerVerified == resource.data.organizerVerified
      );

      allow delete: if isAdmin() || (
        signedIn() && resource.data.organizerUid == request.auth.uid
      );
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.sellerUid is string
        && request.resource.data.listingId is string
        && request.resource.data.sellerUid != request.auth.uid
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'approved'
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerUid == request.resource.data.sellerUid;

      allow read: if signedIn() && (
        resource.data.buyerUid == request.auth.uid
        || resource.data.sellerUid == request.auth.uid
        || isAdmin()
      );

      allow update: if signedIn()
        && (
          resource.data.buyerUid == request.auth.uid
          || resource.data.sellerUid == request.auth.uid
          || isAdmin()
        )
        && request.resource.data.buyerUid == resource.data.buyerUid
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.listingId == resource.data.listingId;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);

        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 8000;

        allow update, delete: if false;
      }
    }
  }
}